# AgentAtlas — Environment variable template
# Copy to .env for local dev. NEVER commit .env — only .env.example belongs in Git.
# In AWS: all values come from Secrets Manager at runtime, not from this file.

# ── Backend ────────────────────────────────────────────────────────────────
# Local dev uses SQLite. Production points at the RDS instance from Terraform output.
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# DATABASE_URL=postgresql+asyncpg://agentatlas_app:PASSWORD@HOSTNAME/agentatlas

# Change this before exposing the API to anyone. In AWS this is injected
# from Secrets Manager (agentatlas/mvp/app-secrets → JWT_SECRET).
JWT_SECRET=change-me-before-any-real-deployment

# Log level: DEBUG for local, INFO for staging/prod
LOG_LEVEL=INFO

# OTEL endpoint — leave blank to disable tracing locally
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── AWS (only needed for infra/CI work locally) ────────────────────────────
AWS_DEFAULT_REGION=us-east-1
# AWS_ACCOUNT_ID=123456789012    # set when running bootstrap.sh

# ── GitHub Actions secrets (set in repo Settings → Secrets) ───────────────
# These are here for documentation only — they are not read from .env in CI.
# AWS_ACCOUNT_ID          → GitHub secret
# CODESTAR_CONNECTION_ARN → GitHub secret (created in AWS console)

# ── Frontend ───────────────────────────────────────────────────────────────
# The frontend reads API_BASE from this at build time (via Vite import.meta.env)
VITE_API_BASE=http://localhost:8215
